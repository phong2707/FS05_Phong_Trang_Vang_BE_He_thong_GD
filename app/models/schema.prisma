// ==========================================
// CẤU HÌNH PRISMA
// ==========================================
generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "sqlite"
}

// ==========================================
// PHẦN 1: QUẢN LÝ NGƯỜI DÚNG & PHÂN QUYỀN (RBAC)
// ==========================================

// 📌 BẢNG: User (Người dùng)
// Tác dụng: Lưu trữ thông tin tài khoản chung (Admin, Giáo viên, Học viên, TA).
// Tại sao cần: Là trung tâm của hệ thống, kết nối mọi hoạt động (học, dạy, thanh toán, thảo luận).
model User {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  deleted   Boolean   @default(false) @map("deleted")

  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  middleName  String?   @map("middle_name")
  email       String    @unique @map("email")
  status      String    @default("PENDING") @map("status") // ACTIVE, INACTIVE, PENDING
  avatarUrl   String?   @map("avatar_url")
  gender      String?   @map("gender")
  phoneNumber String?   @map("phone_number")
  address     String?   @map("address")
  googleId    String?   @unique @map("google_id")
  ekycStatus  String    @default("NOT_REQUIRED") @map("ekyc_status")
  lastLoginAt DateTime? @map("last_login_at")

  // --- Quan hệ Phân quyền ---
  roles             UserToRole[]
  permissions       UserToPermission[]
  passwords         Password[]
  roleCreated       Role[]             @relation("createdBy")
  roleUpdated       Role[]             @relation("updatedBy")
  featureCreated    Feature[]          @relation("createdBy")
  featureUpdated    Feature[]          @relation("updatedBy")
  permissionCreated Permission[]       @relation("createdBy")
  permissionUpdated Permission[]       @relation("updatedBy")
  requestCreator    Request[]          @relation("createdBy")
  requestApprover   Request[]          @relation("approvedBy")

  // --- Quan hệ Học tập & Giảng dạy ---
  managedCourses    Course[]           @relation("AdminManager")
  teachingSubjects  SubjectTeacher[]
  classEnrollments  ClassGroupUser[] // Học Live/Offline theo lớp
  courseEnrollments CourseEnrollment[] // Ghi danh học online tự do
  certificates      Certificate[] // Chứng chỉ đạt được
  questions         Question[]
  submissions       Submission[]
  gradedSubmissions Submission[]       @relation("Grader")
  attendances       Attendance[]
  learningProgress  LearningProgress[]
  gradedByMe SubjectGrade[] @relation("GradeUpdatedBy")
  subjectGrades SubjectGrade[]

  // --- Quan hệ Tương tác & Tài chính ---
  forumPosts       ForumPost[]
  sentMessages     Message[]      @relation("Sender")
  receivedMessages Message[]      @relation("Receiver")
  notifications    Notification[]
  courseReviews    CourseReview[]
  wallet           Wallet?
  transactions     Transaction[]
  schedules        Schedule[]

  @@map("users")
}

// 📌 BẢNG: Password (Mật khẩu & Xác thực)
// Tác dụng: Lưu trữ mật khẩu hoặc mã OTP, Refresh Token của User.
// Tại sao cần: Tách khỏi bảng User để dễ dàng hỗ trợ nhiều hình thức đăng nhập, đổi mật khẩu đa nền tảng.
model Password {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  deleted   Boolean   @default(false) @map("deleted")

  password String
  userId   String @map("user_id")
  type     String @default("PASSWORD") @map("type") // PASSWORD, OTP, REFRESH_TOKEN

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passwords")
}

// 📌 BẢNG: Role (Vai trò)
// Tác dụng: Định nghĩa các nhóm quyền (VD: ADMIN, TEACHER, STUDENT).
// Tại sao cần: Dùng để phân quyền nhóm, thay vì phải đi gán từng quyền lặt vặt cho từng User.
model Role {
  id          String    @id @default(uuid()) @map("id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deleted     Boolean   @default(false) @map("deleted")

  code        String  @unique @map("code")
  name        String  @map("name")
  description String? @map("description")
  isReadOnly  Boolean @default(false) @map("is_read_only")

  users       UserToRole[]
  permissions RoleToPermission[]
  createdBy   User?              @relation("createdBy", fields: [createdById], references: [id])
  updatedBy   User?              @relation("updatedBy", fields: [updatedById], references: [id])

  @@map("roles")
}

// 📌 BẢNG TRUNG GIAN: UserToRole
model UserToRole {
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_to_role")
}

// 📌 BẢNG: Feature (Chức năng hệ thống)
// Tác dụng: Quản lý cây tính năng (VD: Quản lý Khóa học -> Thêm khóa học). Có parentId để phân cấp Menu.
// Tại sao cần: Để admin có thể tự tạo thêm menu/tính năng mà không cần sửa code.
model Feature {
  id          String    @id @default(uuid()) @map("id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deleted     Boolean   @default(false) @map("deleted")

  code        String  @map("code")
  name        String  @map("name")
  description String? @map("description")
  type        String  @default("FEATURE") @map("type")
  parentId    String? @map("parent_id")
  sortOrder   Int     @default(0) @map("sort_order")

  parent      Feature?     @relation("featureRelation", fields: [parentId], references: [id], onDelete: SetNull)
  children    Feature[]    @relation("featureRelation")
  permissions Permission[]
  createdBy   User?        @relation("createdBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("updatedBy", fields: [updatedById], references: [id])

  @@map("features")
}

// 📌 BẢNG: Permission (Quyền hạn chi tiết)
// Tác dụng: Quản lý các hành động (READ, CREATE, UPDATE, DELETE) gán với từng Feature.
// Tại sao cần: Cho phép kiểm soát phân quyền ở cấp độ thao tác (API Level).
model Permission {
  id          String    @id @default(uuid()) @map("id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deleted     Boolean   @default(false) @map("deleted")

  code        String  @map("code")
  name        String  @map("name")
  description String? @map("description")
  type        String  @default("FEATURE") @map("type")
  featureId   String  @map("feature_id")

  feature   Feature            @relation(fields: [featureId], references: [id], onDelete: Cascade)
  users     UserToPermission[]
  roles     RoleToPermission[]
  createdBy User?              @relation("createdBy", fields: [createdById], references: [id])
  updatedBy User?              @relation("updatedBy", fields: [updatedById], references: [id])

  @@map("permissions")
}

// 📌 BẢNG TRUNG GIAN: Quyền của cá nhân & Quyền của vai trò
model UserToPermission {
  userId       String    @map("user_id")
  permissionId String    @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_to_permission")
}

model RoleToPermission {
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_to_permission")
}

// 📌 BẢNG: Request (Yêu cầu phê duyệt)
// Tác dụng: Quản lý các luồng Workflow (VD: Xin cấp quyền giáo viên, Xin duyệt khóa học).
model Request {
  id          String    @id @default(uuid())
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  requestType    String    @map("request_type")
  jsonParameters String    @map("json_parameters")
  status         String    @default("PENDING")
  approvedBy     String?   @map("approved_by")
  approvedAt     DateTime? @map("approved_at")

  requester User  @relation("createdBy", fields: [createdById], references: [id])
  approver  User? @relation("approvedBy", fields: [approvedBy], references: [id])

  @@map("requests")
}

// ==========================================
// PHẦN 2: QUẢN LÝ KHÓA HỌC (COURSE MANAGEMENT & ENROLLMENT)
// ==========================================

// 📌 BẢNG: Course (Khóa học)
// Tác dụng: Khung sườn chính của 1 khóa học (Thông tin thương mại, giá cả, thời lượng).
// Tại sao cần: Là sản phẩm hiển thị trên Landing Page cho user mua/ghi danh.
model Course {
  id           String  @id @default(uuid())
  title        String
  description  String?
  thumbnailUrl String? @map("thumbnail_url")
  price        Float

  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  durationValue Int?      @map("duration_value")
  durationUnit  String?   @default("MONTH") @map("duration_unit")
  daysOfWeek    String?   @map("days_of_week")
  level         String?   @default("BEGINNER")
  maxStudents   Int?      @map("max_students")
  language      String?   @default("VI") @map("language")
  isFeatured    Boolean   @default(false) @map("is_featured")
  discountPrice Float?    @map("discount_price")
  isSequential  Boolean   @default(false) @map("is_sequential") // Bắt buộc học tuần tự toàn khóa?

  status    String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  adminId   String   @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categoryId String?   @map("category_id") // Cho phép null nếu khóa học chưa phân ngành
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  admin         User               @relation("AdminManager", fields: [adminId], references: [id])
  subjects      Subject[]
  enrollments   CourseEnrollment[] // Liên kết danh sách học viên
  rules         CourseRule[] // Liên kết các điều kiện/luật
  certificates  Certificate[]
  courseReviews CourseReview[]
  transactions  Transaction[]
  tests         Test[]

  @@map("courses")
}

// 📌 BẢNG: CourseEnrollment (Ghi danh / Hợp đồng học tập)
// Tác dụng: Lưu trữ việc 1 Học viên đang tham gia 1 Khóa học (Online tự do hoặc Offline).
// Tại sao cần: Để theo dõi tiến độ tổng (% completion), xem khóa nào hoàn thành, khóa nào đang học.
model CourseEnrollment {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  progress    Float     @default(0) // Cache % tiến độ (0 - 100)
  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progresses LearningProgress[] // Chi tiết tiến độ từng bài học

  @@unique([userId, courseId])
  @@index([userId, status])
  @@map("course_enrollments")
}

// 📌 BẢNG: CourseRule (Luật học & Thi)
// Tác dụng: Cấu hình linh hoạt các điều kiện cho khóa học (VD: MAX_ABSENCE = 3, MIN_SCORE = 8).
// Tại sao cần: Đóng vai trò Rule Engine. Cho phép Admin thêm luật mới mà không cần code thêm cột vào bảng Course.
model CourseRule {
  id          String  @id @default(uuid())
  courseId    String  @map("course_id")
  ruleCode    String  @map("rule_code")
  ruleValue   String  @map("rule_value") // Lưu String/JSON tùy ý
  description String?
  isActive    Boolean @default(true) @map("is_active")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, ruleCode])
  @@map("course_rules")
}

// 📌 BẢNG: Certificate (Chứng chỉ)
// Tác dụng: Lưu trữ chứng chỉ khi sinh viên hoàn thành 100% khóa học và thỏa mãn CourseRules.
// Tại sao cần: Cấp bằng chứng nhận có mã định danh để nhà tuyển dụng có thể tra cứu tính xác thực.
model Certificate {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  courseId       String   @map("course_id")
  certificateUrl String   @map("certificate_url") // Link file PDF chứng chỉ
  referenceCode  String   @unique @map("reference_code") // Mã tra cứu (VD: CERT-2026-XYZ)
  issuedAt       DateTime @default(now()) @map("issued_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("certificates")
}

// 📌 BẢNG: Subject (Môn học)
// Tác dụng: Một khóa học lớn (VD: Fullstack) có thể chia thành nhiều môn (VD: Môn Frontend, Môn Backend).
model Subject {
  id          String  @id @default(uuid())
  courseId    String  @map("course_id")
  name        String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")

  // ✅ THÊM
  isSequential Boolean @default(false) @map("is_sequential")
  allowReview  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teachers    SubjectTeacher[]
  classGroups ClassGroup[]
  chapters    Chapter[]
  questions   Question[] // Ngân hàng câu hỏi chung cho môn
  forums      Forum[]
  tests       Test[]

  grades SubjectGrade[]

  @@map("subjects")
}

// 📌 BẢNG TRUNG GIAN: Phân công giảng viên vào Môn học
model SubjectTeacher {
  subjectId String   @map("subject_id")
  teacherId String   @map("teacher_id")
  type      String   @default("MAIN") @map("type") // MAIN, TA
  createdAt DateTime @default(now()) @map("created_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId])
  @@map("subject_teachers")
}

// 📌 BẢNG: Chapter (Chương / Học phần)
// Tác dụng: Gom nhóm bài giảng (Video/Task/Test) thành từng chương theo Lộ trình học (Learning Path).
// Tại sao cần: Quản lý việc khóa/mở bài học tuần tự (prerequisiteId) bắt buộc sinh viên học theo thứ tự.
model Chapter {
  id        String @id @default(uuid())
  subjectId String @map("subject_id")
  title     String
  sortOrder Int    @default(0) @map("sort_order")

  isLocked       Boolean @default(false) @map("is_locked")
  prerequisiteId String? @map("prerequisite_id") // ID của chương bắt buộc phải học trước

  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  prerequisite Chapter?  @relation("ChapterSequence", fields: [prerequisiteId], references: [id])
  nextChapters Chapter[] @relation("ChapterSequence")

  videos    Video[]
  taskmen   Taskman[]
  tests     Test[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("chapters")
}

// 📌 BẢNG: ClassGroup (Nhóm Lớp học)
// Tác dụng: Phân sinh viên thành các lớp nhỏ (VD: Lớp Tối 2-4-6, Lớp Cuối tuần) để quản lý Offline/Live.
// Tại sao cần: LMS cần hỗ trợ cả hình thức học tự do (Self-paced) và học theo lớp (Cohort-based).
model ClassGroup {
  id        String @id @default(uuid())
  subjectId String @map("subject_id")
  name      String

  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  maxStudents Int?      @default(30) @map("max_students")
  roomLink    String?   @map("room_link") // Link Meet/Zoom cố định của lớp

  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")

  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  groupUsers  ClassGroupUser[]
  submissions Submission[]
  schedules   Schedule[]
  subjectGrades SubjectGrade[]

  @@map("class_groups")
}

// 📌 BẢNG TRUNG GIAN: Gán Sinh viên vào Lớp
model ClassGroupUser {
  userId       String   @map("user_id")
  classGroupId String   @map("class_group_id")
  role         String   @default("STUDENT")
  joinedAt     DateTime @default(now()) @map("joined_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@id([userId, classGroupId])
  @@map("class_group_users")
}

// ==========================================
// PHẦN 3: NỘI DUNG BÀI GIẢNG & TIẾN ĐỘ (CONTENT & PROGRESS)
// ==========================================

// 📌 BẢNG: Video (Bài giảng Video)
model Video {
  id              String   @id @default(uuid())
  chapterId       String   @map("chapter_id")
  title           String
  videoUrl        String   @map("video_url")
  durationSeconds Int      @map("duration_seconds")
  provider        String // VD: YOUTUBE, VIMEO, AWS_S3
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  chapter          Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  learningProgress LearningProgress[]

  @@map("videos")
}

// 📌 BẢNG: Taskman (Tài liệu / Bài tập thực hành)
model Taskman {
  id        String   @id @default(uuid())
  chapterId String   @map("chapter_id")
  title     String
  fileType  String?  @map("file_type") // PDF, DOCX
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")

  chapter          Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  learningProgress LearningProgress[]

  @@map("taskmen")
}

// 📌 BẢNG: LearningProgress (Tiến độ học tập chi tiết)
// Tác dụng: Track xem sinh viên đang xem video nào, học đến phút thứ mấy (watchTime), hay đã xong bài nào.
// Tại sao cần: Là cơ sở để tính toán % Progress cho bảng CourseEnrollment và Resume video.
model LearningProgress {
  id           String @id @default(uuid())
  enrollmentId String @map("enrollment_id")
  studentId    String @map("student_id")

  videoId String? @map("video_id")
  taskId  String? @map("task_id")
  testId  String? @map("test_id")

  status           String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  watchTimeSeconds Int       @default(0) @map("watch_time_seconds")
  lastAccessedAt   DateTime  @default(now()) @updatedAt @map("last_accessed_at")
  completedAt      DateTime? @map("completed_at")

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video      Video?           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  task       Taskman?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  test       Test?            @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([studentId, status])
  @@map("learning_progress")
}

// ==========================================
// PHẦN 4: THI CỬ & CHẤM ĐIỂM (ASSESSMENT)
// ==========================================

model QuestionType {
  id              String               @id @default(uuid())
  name            String
  description     String?
  questions       Question[]
  generationRules TestGenerationRule[]

  @@map("question_types")
}

// 📌 BẢNG: Question (Ngân hàng câu hỏi)
// Nằm ở cấp Môn học (Subject) để có thể dùng lại cho nhiều Bài thi (Test) khác nhau.
model Question {
  id             String   @id @default(uuid())
  subjectId      String   @map("subject_id")
  teacherId      String   @map("teacher_id")
  typeId         String   @map("type_id")
  questionFormat String   @default("SINGLE_CHOICE") @map("question_format") // Tự luận, Trắc nghiệm
  content        String
  explanation    String?
  createdAt      DateTime @default(now()) @map("created_at")

  subject       Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher       User                 @relation(fields: [teacherId], references: [id])
  questionType  QuestionType         @relation(fields: [typeId], references: [id])
  answers       QuestionAnswer[]
  testLinks     TestQuestion[]
  userResponses UserQuestionAnswer[]

  @@map("questions")
}

model QuestionAnswer {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  answerText String  @map("answer_text")
  isCorrect  Boolean @default(false) @map("is_correct")
  orderIndex Int     @map("order_index")

  question      Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userResponses UserQuestionAnswer[]

  @@map("question_answers")
}

// 📌 BẢNG: Test (Bài kiểm tra / Đề thi)
model Test {
  id String @id @default(uuid())

  // ✅ MULTI SCOPE
  scope String @default("CHAPTER") @map("scope") // CHAPTER | SUBJECT | COURSE

  chapterId String? @map("chapter_id")
  subjectId String? @map("subject_id")
  courseId  String? @map("course_id")

  title           String
  testType        String    @map("test_type") // QUIZ, ESSAY
  durationMinutes Int       @map("duration_minutes")
  isAutoGenerated Boolean   @default(false) @map("is_auto_generated") // true = random từ ngân hàng câu hỏi, false = gán tay từng câu
  maxAttempts     Int       @default(1) @map("max_attempts")
  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  createdAt       DateTime  @default(now()) @map("created_at")

  // ✅ RELATIONS
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  testQuestions    TestQuestion[]
  submissions      Submission[]
  learningProgress LearningProgress[]
  generationRules  TestGenerationRule[]

  @@map("tests")
}


// 📌 BẢNG: TestGenerationRule (Luật sinh đề tự động)
// Tác dụng: Lưu tiêu chí để hệ thống random câu hỏi từ ngân hàng khi SV bắt đầu làm bài.
// Tại sao cần: Thay vì GV gán cứng từng câu, hệ thống tự chọn N câu ngẫu nhiên theo tiêu chí.
model TestGenerationRule {
  id     String @id @default(uuid())
  testId String @map("test_id")

  questionFormat String? @map("question_format") // Lọc theo format: SINGLE_CHOICE, MULTIPLE_CHOICE, ESSAY (null = lấy tất cả format)
  questionTypeId String? @map("question_type_id") // Lọc theo QuestionType (chủ đề/loại câu) (null = lấy tất cả loại)

  totalCount        Int      @map("total_count") // Số câu random lấy ra
  pointsPerQuestion Float    @default(1) @map("points_per_question") // Điểm mỗi câu
  createdAt         DateTime @default(now()) @map("created_at")

  test         Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionType QuestionType? @relation(fields: [questionTypeId], references: [id], onDelete: SetNull)

  @@map("test_generation_rules")
}

model TestQuestion {
  testId     String @map("test_id")
  questionId String @map("question_id")
  points     Float
  sortOrder  Int    @default(0) @map("sort_order")

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@map("test_questions")
}

// 📌 BẢNG: Submission (Nộp bài & Chấm điểm)
// Tác dụng: Lưu trữ kết quả bài làm, hỗ trợ cho việc upload File báo cáo tự luận và FeedBack file của Giáo viên.
model Submission {
  id               String  @id @default(uuid())
  testId           String  @map("test_id")
  studentId        String  @map("student_id")
  classGroupId     String  @map("class_group_id")
  graderId         String? @map("grader_id")
  score            Float?
  status           String  @default("PENDING") // PENDING, GRADED
  finalScoreStatus String? @map("final_score_status") // AUTO_GRADED, MANUAL_PENDING

  studentFileUrl  String? @map("student_file_url") // File báo cáo SV nộp
  teacherFeedback String? @map("teacher_feedback") // Nhận xét của GV
  feedbackFileUrl String? @map("feedback_file_url") // File chấm đỏ của GV

  submittedAt DateTime @default(now()) @map("submitted_at")

  test        Test                 @relation(fields: [testId], references: [id], onDelete: Cascade)
  student     User                 @relation(fields: [studentId], references: [id])
  classGroup  ClassGroup           @relation(fields: [classGroupId], references: [id])
  grader      User?                @relation("Grader", fields: [graderId], references: [id])
  userAnswers UserQuestionAnswer[]

  @@map("submissions")
}

model UserQuestionAnswer {
  id           String  @id @default(uuid())
  submissionId String  @map("submission_id")
  questionId   String  @map("question_id")
  answerId     String? @map("answer_id")
  essayAnswer  String? @map("essay_answer")
  isCorrect    Boolean @map("is_correct")

  submission Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     QuestionAnswer? @relation(fields: [answerId], references: [id], onDelete: SetNull)

  @@map("user_question_answers")
}

// 📌 BẢNG: SubjectGrade (Bảng điểm tổng kết môn học)
// Tác dụng: Lưu trữ bảng điểm của từng sinh viên trong một môn học/lớp học.
// Logic: Teacher sẽ ghi điểm (DRAFT), sau khi PUBLISHED thì Student mới đọc được.
model SubjectGrade {
  id            String    @id @default(uuid())
  subjectId     String    @map("subject_id")
  classGroupId  String    @map("class_group_id")
  studentId     String    @map("student_id")
  
  assignmentScore Float?  @map("assignment_score") // Điểm bài tập
  midtermScore    Float?  @map("midterm_score")    // Điểm giữa kỳ
  finalScore      Float?  @map("final_score")      // Điểm cuối kỳ
  totalScore      Float?  @map("total_score")      // Điểm tổng kết
  
  status          String  @default("DRAFT")        // DRAFT, PUBLISHED
  updatedById     String? @map("updated_by_id")    // Giáo viên/Admin cập nhật
  publishedAt     DateTime? @map("published_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Quan hệ
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy  User?      @relation("GradeUpdatedBy", fields: [updatedById], references: [id])

  @@unique([subjectId, studentId]) // Một sinh viên chỉ có 1 bảng điểm trong 1 môn
  @@map("subject_grades")
}

// ==========================================
// PHẦN 5: LỊCH HỌC, ĐIỂM DANH & TƯƠNG TÁC
// ==========================================

// 📌 BẢNG: Schedule (Lịch học)
// Tác dụng: Phục vụ mô hình Blended Learning (dạy qua Zoom/Meet hoặc dạy Offline).
model Schedule {
  id           String   @id @default(uuid())
  classGroupId String   @map("class_group_id")
  teacherId    String   @map("teacher_id")
  title        String
  description  String?
  startAt      DateTime @map("start_at")
  endAt        DateTime @map("end_at")
  dayOfWeek    Int?     @map("day_of_week")
  roomLink     String?  @map("room_link")
  createdAt    DateTime @default(now()) @map("created_at")

  classGroup  ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher     User         @relation(fields: [teacherId], references: [id])
  attendances Attendance[]

  @@map("schedules")
}

// 📌 BẢNG: Attendance (Điểm danh)
// Tác dụng: Ghi nhận sinh viên Có mặt/Vắng/Trễ. Là dữ liệu để xét duyệt CourseRule (VD: Cấm thi do vắng quá 3 buổi).
model Attendance {
  id         String   @id @default(uuid())
  scheduleId String   @map("schedule_id")
  studentId  String   @map("student_id")
  status     String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id])

  @@unique([scheduleId, studentId])
  @@map("attendances")
}

model Forum {
  id        String  @id @default(uuid())
  subjectId String  @map("subject_id")
  title     String
  isLocked  Boolean @default(false) @map("is_locked")

  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  posts   ForumPost[]

  @@map("forums")
}

model ForumPost {
  id        String   @id @default(uuid())
  forumId   String   @map("forum_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  forum   Forum       @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])
  parent  ForumPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies ForumPost[] @relation("PostReplies")

  @@map("forum_posts")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  content   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  studentId String   @map("student_id")
  rating    Int
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id])

  @@map("course_reviews")
}

// ==========================================
// PHẦN 6: TÀI CHÍNH & THANH TOÁN (Giữ nguyên kiến trúc cũ)
// ==========================================

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  courseId      String   @map("course_id")
  amount        Float
  paymentMethod String   @default("VNPAY") @map("payment_method")
  referenceCode String?  @map("reference_code")
  status        String // SUCCESS, FAILED, PENDING
  createdAt     DateTime @default(now()) @map("created_at")

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@map("transactions")
}

// ==========================================
// PHẦN 7: PHÂN LOẠI & DANH MỤC (CATEGORIES)
// ==========================================

// 📌 BẢNG: Category (Ngành học / Lĩnh vực / Danh mục)
// Tác dụng: Dùng để gom nhóm và lọc khóa học (VD: CNTT, Kinh tế, Thiết kế...).
// Hỗ trợ phân cấp (Parent - Child) để làm chuyên ngành (VD: CNTT -> Lập trình Web).
model Category {
  id          String  @id @default(uuid())
  name        String // Tên ngành (VD: Công nghệ thông tin)
  slug        String  @unique // URL thân thiện (VD: cong-nghe-thong-tin)
  description String?
  iconUrl     String? @map("icon_url") // Icon hiển thị trên menu lọc

  parentId  String? @map("parent_id") // Dành cho ngành con
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Quan hệ tự thân (Self-relation) để tạo cấp bậc Ngành lớn -> Ngành nhỏ
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("SubCategories")

  // Quan hệ 1-N với Khóa học
  courses Course[]

  @@map("categories")
}
