// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "sqlite"
}


// ==========================================
// 1. USER & SECURITY MANAGEMENT (RBAC)
// ==========================================

model User {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name")
  email        String    @unique
  avatarUrl    String?   @map("avatar_url")
  dateOfBirth  DateTime? @map("date_of_birth")
  gender       String?   // MALE, FEMALE, OTHER
  address      String?
  phoneNumber  String?   @map("phone_number")
  status       String    @default("PENDING") // ACTIVE, INACTIVE, PENDING
  googleId     String?   @unique @map("google_id")
  ekycStatus   String    @default("NOT_REQUIRED") @map("ekyc_status")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deleted      Boolean   @default(false)

  // Relations
  passwords         Password[]
  userRoles         UserToRole[]
  userPermissions   UserToPermission[]
  
  // Workflow & Content Relations
  createdRequests   ApprovalRequest[] @relation("CreatedBy")
  approvedRequests  ApprovalRequest[] @relation("ApprovedBy")
  managedCourses    Course[]          @relation("AdminManager")
  courseAssignments CourseTeacher[]
  classEnrollments  ClassGroupUser[]
  questions         Question[]
  submissions       Submission[]
  gradedSubmissions Submission[]      @relation("Grader")
  forumPosts        ForumPost[]
  sentMessages      Message[]         @relation("Sender")
  receivedMessages  Message[]         @relation("Receiver")
  notifications     Notification[]
  courseReviews     CourseReview[]
  learningProgress  LearningProgress[]
  wallet            Wallet?
  transactions      Transaction[]
  schedules         Schedule[]

  @@map("users")
}

model Password {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  password  String
  type      String   @default("PASSWORD") // PASSWORD, OTP, REFRESH_TOKEN
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passwords")
}

model Role {
  id          String   @id @default(uuid())
  roleCode    String   @unique @map("role_code") // ADMIN, TEACHER, STUDENT
  roleName    String   @map("role_name")
  description String?
  isReadOnly  Boolean  @default(false) @map("is_read_only")

  users       UserToRole[]
  permissions RoleToPermission[]

  @@map("roles")
}

model Feature {
  id          String   @id @default(uuid())
  featureCode String   @map("feature_code")
  featureName String   @map("feature_name")
  type        String   @default("FEATURE") // MENU_GROUP, SYSTEM, FEATURE
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")

  parent      Feature?     @relation("FeatureTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Feature[]    @relation("FeatureTree")
  permissions Permission[]

  @@map("features")
}

model Permission {
  id             String   @id @default(uuid())
  permissionCode String   @map("permission_code")
  permissionName String   @map("permission_name")
  featureId      String   @map("feature_id")

  feature   Feature            @relation(fields: [featureId], references: [id], onDelete: Cascade)
  roles     RoleToPermission[]
  users     UserToPermission[]

  @@map("permissions")
}

// Bảng trung gian Many-to-Many
model UserToRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_to_role")
}

model RoleToPermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_to_permission")
}

model UserToPermission {
  userId       String @map("user_id")
  permissionId String @map("permission_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_to_permission")
}

model ApprovalRequest {
  id           String    @id @default(uuid())
  creatorId    String    @map("creator_id")
  requestType  String    @map("request_type")
  jsonData     String    @map("json_data") // Lưu stringified JSON cho SQLite
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approverId   String?   @map("approver_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  approvedAt   DateTime? @map("approved_at")

  creator  User  @relation("CreatedBy", fields: [creatorId], references: [id])
  approver User? @relation("ApprovedBy", fields: [approverId], references: [id])

  @@map("approval_requests")
}

// ==========================================
// 2. COURSE & CONTENT MANAGEMENT
// ==========================================

model Course {
  id           String   @id @default(uuid())
  title        String
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  price        Float
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  adminId      String   @map("admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  admin         User            @relation("AdminManager", fields: [adminId], references: [id])
  teachers      CourseTeacher[]
  subjects      Subject[]
  courseReviews CourseReview[]
  transactions  Transaction[]

  @@map("courses")
}

model CourseTeacher {
  courseId  String   @map("course_id")
  teacherId String   @map("teacher_id")
  role      String   @default("MAIN_TEACHER")
  assignedAt DateTime @default(now()) @map("assigned_at")

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([courseId, teacherId])
  @@map("course_teachers")
}

model Subject {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classGroups ClassGroup[]
  taskmen     Taskman[]
  videos      Video[]
  questions   Question[]
  tests       Test[]
  forums      Forum[]

  @@map("subjects")
}

model ClassGroup {
  id        String   @id @default(uuid())
  subjectId String   @map("subject_id")
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")

  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  groupUsers  ClassGroupUser[]
  submissions Submission[]
  schedules   Schedule[]

  @@map("class_groups")
}

model ClassGroupUser {
  userId       String   @map("user_id")
  classGroupId String   @map("class_group_id")
  role         String   @default("STUDENT") // STUDENT, TEACHER
  joinedAt     DateTime @default(now()) @map("joined_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@id([userId, classGroupId])
  @@map("class_group_users")
}

// ==========================================
// 3. TASKS, TESTS & GRADES
// ==========================================

model Taskman {
  id        String   @id @default(uuid())
  subjectId String   @map("subject_id")
  title     String
  fileType  String?  @map("file_type") // PDF, WORD, LINK
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")

  subject          Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  learningProgress LearningProgress[]

  @@map("taskmen")
}

model Video {
  id              String   @id @default(uuid())
  subjectId       String   @map("subject_id")
  title           String
  videoUrl        String   @map("video_url")
  durationSeconds Int      @map("duration_seconds")
  provider        String   // YOUTUBE, VIMEO, INTERNAL
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  subject          Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  learningProgress LearningProgress[]

  @@map("videos")
}

model QuestionType {
  id          String     @id @default(uuid())
  name        String
  description String?
  questions   Question[]

  @@map("question_types")
}

model Question {
  id             String   @id @default(uuid())
  subjectId      String   @map("subject_id")
  teacherId      String   @map("teacher_id")
  typeId         String   @map("type_id")
  questionFormat String   @default("SINGLE_CHOICE") @map("question_format")
  content        String
  explanation    String?
  createdAt      DateTime @default(now()) @map("created_at")

  subject      Subject          @relation(fields: [subjectId], references: [id])
  teacher      User             @relation(fields: [teacherId], references: [id])
  questionType QuestionType     @relation(fields: [typeId], references: [id])
  answers      QuestionAnswer[]
  testLinks    TestQuestion[]
  userResponses UserQuestionAnswer[]

  @@map("questions")
}

model QuestionAnswer {
  id          String  @id @default(uuid())
  questionId  String  @map("question_id")
  answerText  String  @map("answer_text")
  isCorrect   Boolean @default(false) @map("is_correct")
  orderIndex  Int     @map("order_index")

  question      Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userResponses UserQuestionAnswer[]

  @@map("question_answers")
}

model Test {
  id              String    @id @default(uuid())
  subjectId       String    @map("subject_id")
  title           String
  testType        String    @map("test_type") // QUIZ, ASSIGNMENT
  durationMinutes Int       @map("duration_minutes")
  maxAttempts     Int       @default(1) @map("max_attempts")
  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  createdAt       DateTime  @default(now()) @map("created_at")

  subject          Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  testQuestions    TestQuestion[]
  submissions      Submission[]
  learningProgress LearningProgress[]

  @@map("tests")
}

model TestQuestion {
  testId     String @map("test_id")
  questionId String @map("question_id")
  points     Float
  sortOrder  Int    @default(0) @map("sort_order")

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@map("test_questions")
}

model Submission {
  id               String    @id @default(uuid())
  testId           String    @map("test_id")
  studentId        String    @map("student_id")
  classGroupId     String    @map("class_group_id")
  graderId         String?   @map("grader_id")
  score            Float?
  status           String    // PENDING, GRADED
  finalScoreStatus String?   @map("final_score_status") // AUTO_GRADED, MANUAL_PENDING
  submittedAt      DateTime  @default(now()) @map("submitted_at")

  test           Test                 @relation(fields: [testId], references: [id], onDelete: Cascade)
  student        User                 @relation(fields: [studentId], references: [id])
  classGroup     ClassGroup           @relation(fields: [classGroupId], references: [id])
  grader         User?                @relation("Grader", fields: [graderId], references: [id])
  userAnswers    UserQuestionAnswer[]

  @@map("submissions")
}

model UserQuestionAnswer {
  id           String  @id @default(uuid())
  submissionId String  @map("submission_id")
  questionId   String  @map("question_id")
  answerId     String? @map("answer_id")
  essayAnswer  String? @map("essay_answer")
  isCorrect    Boolean @map("is_correct")

  submission Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id])
  answer     QuestionAnswer? @relation(fields: [answerId], references: [id])

  @@map("user_question_answers")
}

model LearningProgress {
  id          String    @id @default(uuid())
  studentId   String    @map("student_id")
  videoId     String?   @map("video_id")
  taskId      String?   @map("task_id")
  testId      String?   @map("test_id")
  status      String    @default("COMPLETED")
  completedAt DateTime? @map("completed_at")

  student User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video   Video?   @relation(fields: [videoId], references: [id])
  task    Taskman? @relation(fields: [taskId], references: [id])
  test    Test?    @relation(fields: [testId], references: [id])

  @@map("learning_progress")
}

// ==========================================
// 4. INTERACTION & SCHEDULE
// ==========================================

model Forum {
  id        String   @id @default(uuid())
  subjectId String   @map("subject_id")
  title     String
  isLocked  Boolean  @default(false) @map("is_locked")

  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  posts   ForumPost[]

  @@map("forums")
}

model ForumPost {
  id        String   @id @default(uuid())
  forumId   String   @map("forum_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  forum    Forum       @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id])
  parent   ForumPost?  @relation("PostReplies", fields: [parentId], references: [id])
  replies  ForumPost[] @relation("PostReplies")

  @@map("forum_posts")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@map("messages")
}

model Schedule {
  id           String   @id @default(uuid())
  classGroupId String   @map("class_group_id")
  teacherId    String   @map("teacher_id")
  title        String
  description  String?
  startAt      DateTime @map("start_at")
  endAt        DateTime @map("end_at")
  dayOfWeek    Int      @map("day_of_week")
  roomLink     String?  @map("room_link")
  createdAt    DateTime @default(now()) @map("created_at")

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher    User       @relation(fields: [teacherId], references: [id])

  @@map("schedules")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  content   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  studentId String   @map("student_id")
  rating    Int
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id])

  @@map("course_reviews")
}

// ==========================================
// 5. FINANCE
// ==========================================

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  courseId      String   @map("course_id")
  amount        Float
  paymentMethod String   @default("VNPAY") @map("payment_method")
  referenceCode String?  @map("reference_code")
  status        String   // SUCCESS, FAILED, PENDING
  createdAt     DateTime @default(now()) @map("created_at")

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@map("transactions")
}