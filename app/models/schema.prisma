// ==========================================
// CONFIGURATION
// ==========================================

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "sqlite"
}
// ==========================================
// 1. USER & SECURITY MANAGEMENT (RBAC)
// ==========================================

model User {
  id        String    @id @default(uuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  deleted   Boolean   @default(false) @map("deleted")

  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  middleName  String?   @map("middle_name")
  email       String    @unique @map("email")
  status      String    @default("PENDING") @map("status") // ACTIVE, INACTIVE, PENDING
  avatarUrl   String?   @map("avatar_url")
  gender      String?   @map("gender")
  phoneNumber String?   @map("phone_number")
  address     String?   @map("address")
  googleId    String?   @unique @map("google_id")
  ekycStatus  String    @default("NOT_REQUIRED") @map("ekyc_status")
  lastLoginAt DateTime? @map("last_login_at")

  // --- RBAC Relations ---
  roles             UserToRole[]
  permissions       UserToPermission[]
  passwords         Password[]
  roleCreated       Role[]             @relation("createdBy")
  roleUpdated       Role[]             @relation("updatedBy")
  featureCreated    Feature[]          @relation("createdBy")
  featureUpdated    Feature[]          @relation("updatedBy")
  permissionCreated Permission[]       @relation("createdBy")
  permissionUpdated Permission[]       @relation("updatedBy")
  requestCreator    Request[]          @relation("createdBy")
  requestApprover   Request[]          @relation("approvedBy")

  // --- LMS Relations ---
  managedCourses    Course[]           @relation("AdminManager")
  classEnrollments  ClassGroupUser[]
  teachingSubjects  SubjectTeacher[]
  questions         Question[]
  submissions       Submission[]
  gradedSubmissions Submission[]       @relation("Grader")
  attendances       Attendance[]
  forumPosts        ForumPost[]
  sentMessages      Message[]          @relation("Sender")
  receivedMessages  Message[]          @relation("Receiver")
  notifications     Notification[]
  courseReviews     CourseReview[]
  learningProgress  LearningProgress[]
  wallet            Wallet?
  transactions      Transaction[]
  schedules         Schedule[]

  @@map("users")
}

model Password {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  deleted   Boolean   @default(false) @map("deleted")

  password String
  userId   String @map("user_id")
  type     String @default("PASSWORD") @map("type") // PASSWORD, OTP, REFRESH_TOKEN

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passwords")
}

model Role {
  id          String    @id @default(uuid()) @map("id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deleted     Boolean   @default(false) @map("deleted")

  code        String  @unique @map("code")
  name        String  @map("name")
  description String? @map("description")
  isReadOnly  Boolean @default(false) @map("is_read_only")

  users       UserToRole[]
  permissions RoleToPermission[]
  createdBy   User?              @relation("createdBy", fields: [createdById], references: [id])
  updatedBy   User?              @relation("updatedBy", fields: [updatedById], references: [id])

  @@map("roles")
}

model UserToRole {
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_to_role")
}

model Feature {
  id          String    @id @default(uuid()) @map("id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deleted     Boolean   @default(false) @map("deleted")

  code        String  @map("code")
  name        String  @map("name")
  description String? @map("description")
  type        String  @default("FEATURE") @map("type")
  parentId    String? @map("parent_id")
  sortOrder   Int     @default(0) @map("sort_order")

  parent      Feature?     @relation("featureRelation", fields: [parentId], references: [id], onDelete: SetNull)
  children    Feature[]    @relation("featureRelation")
  permissions Permission[]
  createdBy   User?        @relation("createdBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("updatedBy", fields: [updatedById], references: [id])

  @@map("features")
}

model Permission {
  id          String    @id @default(uuid()) @map("id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deleted     Boolean   @default(false) @map("deleted")

  code        String  @map("code")
  name        String  @map("name")
  description String? @map("description")
  type        String  @default("FEATURE") @map("type")
  featureId   String  @map("feature_id")

  feature   Feature            @relation(fields: [featureId], references: [id], onDelete: Cascade)
  users     UserToPermission[]
  roles     RoleToPermission[]
  createdBy User?              @relation("createdBy", fields: [createdById], references: [id])
  updatedBy User?              @relation("updatedBy", fields: [updatedById], references: [id])

  @@map("permissions")
}

model UserToPermission {
  userId       String    @map("user_id")
  permissionId String    @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_to_permission")
}

model RoleToPermission {
  roleId       String    @map("role_id")
  permissionId String    @map("permission_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_to_permission")
}

model Request {
  id          String    @id @default(uuid())
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  requestType    String    @map("request_type")
  jsonParameters String    @map("json_parameters")
  status         String    @default("PENDING")
  approvedBy     String?   @map("approved_by")
  approvedAt     DateTime? @map("approved_at")

  requester User  @relation("createdBy", fields: [createdById], references: [id])
  approver  User? @relation("approvedBy", fields: [approvedBy], references: [id])

  @@map("requests")
}

model SubjectTeacher {
  subjectId String   @map("subject_id")
  teacherId String   @map("teacher_id")
  type      String   @default("MAIN") @map("type") // MAIN, TA
  createdAt DateTime @default(now()) @map("created_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([subjectId, teacherId])
  @@map("subject_teachers")
}

// ==========================================
// 2. COURSE, SUBJECT & CLASS MANAGEMENT
// ==========================================

model Course {
  id           String   @id @default(uuid())
  title        String
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  price        Float
  
  // --- Fields Thực tế ---
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  durationValue Int?     @map("duration_value") 
  durationUnit  String?  @default("MONTH") @map("duration_unit") 
  daysOfWeek    String?  @map("days_of_week") 
  level         String?  @default("BEGINNER")   
  maxStudents   Int?     @map("max_students")   
  language      String?  @default("VI") @map("language") 
  isFeatured    Boolean  @default(false) @map("is_featured")
  discountPrice Float?   @map("discount_price")
  
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  adminId      String   @map("admin_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  admin         User           @relation("AdminManager", fields: [adminId], references: [id])
  subjects      Subject[]
  courseReviews CourseReview[]
  transactions  Transaction[]

  @@map("courses")
}

model Subject {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teachers    SubjectTeacher[]
  classGroups ClassGroup[]
  chapters    Chapter[]        // Đã thay đổi: Liên kết tới Chapter thay vì bài học trực tiếp
  questions   Question[]
  forums      Forum[]

  @@map("subjects")
}

// --- BẢNG MỚI: Chương học ---
model Chapter {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  title       String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  videos      Video[]
  taskmen     Taskman[]
  tests       Test[]

  @@map("chapters")
}

model ClassGroup {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  name        String
  
  // --- Fields Thực tế cho Lớp học ---
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  maxStudents Int?      @default(30) @map("max_students")
  roomLink    String?   @map("room_link") // Link Meet/Zoom cố định

  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")

  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  groupUsers  ClassGroupUser[]
  submissions Submission[]
  schedules   Schedule[]

  @@map("class_groups")
}

model ClassGroupUser {
  userId       String   @map("user_id")
  classGroupId String   @map("class_group_id")
  role         String   @default("STUDENT")
  joinedAt     DateTime @default(now()) @map("joined_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@id([userId, classGroupId])
  @@map("class_group_users")
}

// ==========================================
// 3. CONTENT, TESTS & GRADES (Theo Chapter)
// ==========================================

model Taskman {
  id        String   @id @default(uuid())
  chapterId String   @map("chapter_id")
  title     String
  fileType  String?  @map("file_type")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")

  chapter          Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  learningProgress LearningProgress[]

  @@map("taskmen")
}

model Video {
  id              String   @id @default(uuid())
  chapterId       String   @map("chapter_id")
  title           String
  videoUrl        String   @map("video_url")
  durationSeconds Int      @map("duration_seconds")
  provider        String
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  chapter          Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  learningProgress LearningProgress[]

  @@map("videos")
}

model QuestionType {
  id          String     @id @default(uuid())
  name        String
  description String?
  questions   Question[]

  @@map("question_types")
}

model Question {
  id             String   @id @default(uuid())
  subjectId      String   @map("subject_id") // Vẫn giữ ở cấp Môn học để dùng chung
  teacherId      String   @map("teacher_id")
  typeId         String   @map("type_id")
  questionFormat String   @default("SINGLE_CHOICE") @map("question_format")
  content        String
  explanation    String?
  createdAt      DateTime @default(now()) @map("created_at")

  subject       Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher       User                 @relation(fields: [teacherId], references: [id])
  questionType  QuestionType         @relation(fields: [typeId], references: [id])
  answers       QuestionAnswer[]
  testLinks     TestQuestion[]
  userResponses UserQuestionAnswer[]

  @@map("questions")
}

model QuestionAnswer {
  id         String  @id @default(uuid())
  questionId String  @map("question_id")
  answerText String  @map("answer_text")
  isCorrect  Boolean @default(false) @map("is_correct")
  orderIndex Int     @map("order_index")

  question      Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userResponses UserQuestionAnswer[]

  @@map("question_answers")
}

model Test {
  id              String    @id @default(uuid())
  chapterId       String    @map("chapter_id")
  title           String
  testType        String    @map("test_type") // QUIZ, ESSAY
  durationMinutes Int       @map("duration_minutes")
  maxAttempts     Int       @default(1) @map("max_attempts")
  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  createdAt       DateTime  @default(now()) @map("created_at")

  chapter          Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  testQuestions    TestQuestion[]
  submissions      Submission[]
  learningProgress LearningProgress[]

  @@map("tests")
}

model TestQuestion {
  testId     String @map("test_id")
  questionId String @map("question_id")
  points     Float
  sortOrder  Int    @default(0) @map("sort_order")

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@map("test_questions")
}

model Submission {
  id               String   @id @default(uuid())
  testId           String   @map("test_id")
  studentId        String   @map("student_id")
  classGroupId     String   @map("class_group_id")
  graderId         String?  @map("grader_id")
  score            Float?
  status           String   @default("PENDING") // PENDING, GRADED
  finalScoreStatus String?  @map("final_score_status") // AUTO_GRADED, MANUAL_PENDING
  
  // --- Bổ sung xử lý File cho Tự luận ---
  studentFileUrl   String?  @map("student_file_url")
  teacherFeedback  String?  @map("teacher_feedback")
  feedbackFileUrl  String?  @map("feedback_file_url")

  submittedAt      DateTime @default(now()) @map("submitted_at")

  test        Test                 @relation(fields: [testId], references: [id], onDelete: Cascade)
  student     User                 @relation(fields: [studentId], references: [id])
  classGroup  ClassGroup           @relation(fields: [classGroupId], references: [id])
  grader      User?                @relation("Grader", fields: [graderId], references: [id])
  userAnswers UserQuestionAnswer[]

  @@map("submissions")
}

model UserQuestionAnswer {
  id           String  @id @default(uuid())
  submissionId String  @map("submission_id")
  questionId   String  @map("question_id")
  answerId     String? @map("answer_id")
  essayAnswer  String? @map("essay_answer")
  isCorrect    Boolean @map("is_correct")

  submission Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     QuestionAnswer? @relation(fields: [answerId], references: [id], onDelete: SetNull)

  @@map("user_question_answers")
}

model LearningProgress {
  id          String    @id @default(uuid())
  studentId   String    @map("student_id")
  videoId     String?   @map("video_id")
  taskId      String?   @map("task_id")
  testId      String?   @map("test_id")
  status      String    @default("COMPLETED")
  completedAt DateTime? @map("completed_at")

  student User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video   Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  task    Taskman? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  test    Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("learning_progress")
}

// ==========================================
// 4. INTERACTION, SCHEDULE & FINANCE
// ==========================================

model Schedule {
  id           String   @id @default(uuid())
  classGroupId String   @map("class_group_id")
  teacherId    String   @map("teacher_id")
  title        String
  description  String?
  startAt      DateTime @map("start_at")
  endAt        DateTime @map("end_at")
  dayOfWeek    Int?     @map("day_of_week") // Optional: dùng cho lịch lặp lại
  roomLink     String?  @map("room_link") // Link riêng cho buổi học (nếu có)
  createdAt    DateTime @default(now()) @map("created_at")

  classGroup  ClassGroup   @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher     User         @relation(fields: [teacherId], references: [id])
  attendances Attendance[]

  @@map("schedules")
}

// --- BẢNG MỚI: Điểm danh ---
model Attendance {
  id           String   @id @default(uuid())
  scheduleId   String   @map("schedule_id") 
  studentId    String   @map("student_id")  
  status       String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student      User     @relation(fields: [studentId], references: [id])

  @@unique([scheduleId, studentId]) 
  @@map("attendances")
}

model Forum {
  id        String  @id @default(uuid())
  subjectId String  @map("subject_id")
  title     String
  isLocked  Boolean @default(false) @map("is_locked")

  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  posts   ForumPost[]

  @@map("forums")
}

model ForumPost {
  id        String   @id @default(uuid())
  forumId   String   @map("forum_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  forum   Forum       @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])
  parent  ForumPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies ForumPost[] @relation("PostReplies")

  @@map("forum_posts")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  content   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model CourseReview {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  studentId String   @map("student_id")
  rating    Int
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id])

  @@map("course_reviews")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  courseId      String   @map("course_id")
  amount        Float
  paymentMethod String   @default("VNPAY") @map("payment_method")
  referenceCode String?  @map("reference_code")
  status        String   // SUCCESS, FAILED, PENDING
  createdAt     DateTime @default(now()) @map("created_at")

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@map("transactions")
}